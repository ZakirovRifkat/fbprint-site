# Сайт открывается только по HTTPS.
# Сначала выпустите SSL-сертификат для fb-print.ru в панели reg.ru, иначе сайт перестанет открываться.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Настройки почты браузеру не отдаются
<FilesMatch "^config(\.example)?\.php$">
  Require all denied
</FilesMatch>
